  create  table "jeans_source_db"."marts"."fct_order_fulfillment__dbt_tmp"
  
  
    as
  
  (
    -- models/marts/fct_order_fulfillment.sql



WITH orders AS (
    SELECT * FROM "jeans_source_db"."staging"."stg_unpivoted_orders"
),

prod_logs AS (
    SELECT * FROM "jeans_source_db"."staging"."stg_production_logs"
),

latest_prod AS (
    SELECT 
        order_form_no,
        stage AS current_production_stage,
        updated_at AS last_stage_updated_at
    FROM (
        SELECT *, ROW_NUMBER() OVER (PARTITION BY order_form_no ORDER BY updated_at DESC) as rn
        FROM prod_logs
    ) t
    WHERE rn = 1
)

SELECT
    o.order_form_no,
    o.order_date,
    o.buyer_name,
    o.buyer_location,
    o.style_number,
    SUM(o.quantity) as total_order_quantity,
    MAX(lp.current_production_stage) as current_production_stage,
    MAX(lp.last_stage_updated_at) as last_stage_updated_at
FROM orders o
LEFT JOIN latest_prod lp ON o.order_form_no = lp.order_form_no
GROUP BY 
    o.order_form_no,
    o.order_date,
    o.buyer_name,
    o.buyer_location,
    o.style_number
  );
  
