[0m15:16:23.027085 [debug] [Thread-1 (]: On model.jeans_mfg_data_pipeline.stg_unpivoted_orders: /* {"app": "dbt", "dbt_version": "1.11.2", "profile_name": "jeans_mfg_data_pipeline", "target_name": "dev", "node_id": "model.jeans_mfg_data_pipeline.stg_unpivoted_orders"} */

  create view "postgres"."public_staging"."stg_unpivoted_orders__dbt_tmp"
    
    
  as (
    -- models/staging/stg_unpivoted_orders.sql



WITH source_orders AS (

    SELECT *
    FROM "postgres"."raw"."raw_orders"

),

unpivoted AS (

    SELECT
        o.order_form_no,
        o.order_date,
        o.buyer_name,
        o.buyer_location,
        o.s_no,
        o.style_number,
        o.unit_price,
        o.line_item_total,
        o.total_qty_line_item,
        o.ingested_at,
        u.size,
        u.quantity_ordered AS quantity
    FROM source_orders o
    CROSS JOIN LATERAL (
        VALUES
            ('18', o.size_18_qty),
            ('20', o.size_20_qty),
            ('22', o.size_22_qty),
            ('24', o.size_24_qty),
            ('26', o.size_26_qty),
            ('28', o.size_28_qty),
            ('30', o.size_30_qty),
            ('32', o.size_32_qty),
            ('34', o.size_34_qty),
            ('36', o.size_36_qty),
            ('38', o.size_38_qty),
            ('40', o.size_40_qty),
            ('42', o.size_42_qty)
    ) AS u(size, quantity_ordered)

)

SELECT *
FROM unpivoted
WHERE quantity > 0
  );
